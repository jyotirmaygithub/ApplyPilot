# ApplyPilot Environment Configuration
# Copy to ~/.applypilot/.env (and optionally ./.env) and fill in your values.
# Do not put real secrets in this example file.

# LLM Provider — Cursor only for this setup (no Gemini)
LLM_PROVIDER=cursor
APPLY_AGENT=cursor
CURSOR_API_KEY=your_cursor_api_key_here
CURSOR_MODEL=composer-2.5
LLM_MODEL=composer-2.5

# Other providers (leave unused)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_URL=http://127.0.0.1:8080/v1

# Auto-Apply (optional)
CAPSOLVER_API_KEY=
# JOB_PORTAL_SIGNUP=0
# JOB_PORTAL_PASSWORD=

# Proxy (optional, for scraping)
# PROXY=host:port:user:pass
